# ========== 数据库连接（PostgreSQL）==========
# 本地开发: DB_HOST=127.0.0.1
# 远程 NAS:  DB_HOST=100.97.128.94（需要 Tailscale 组网）
DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=mindharness
DB_USERNAME=mindharness
DB_PASSWORD=mindharness123

# ========== 服务端口 ==========
BACKEND_PORT=8080
FRONTEND_PORT=15173

# ========== AI API Keys ==========
# DeepSeek API Key（从 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=

# 智谱 AI API Key（从 https://open.bigmodel.cn 获取，可选）
ZHIPUAI_API_KEY=
