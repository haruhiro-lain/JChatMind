<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mindharness.mapper.AgentMapper">

    <resultMap id="BaseResultMap" type="com.mindharness.model.entity.Agent">
        <id property="id" column="id" jdbcType="VARCHAR"/>
        <result property="name" column="name" jdbcType="VARCHAR"/>
        <result property="description" column="description" jdbcType="VARCHAR"/>
        <result property="systemPrompt" column="system_prompt" jdbcType="VARCHAR"/>
        <result property="model" column="model" jdbcType="VARCHAR"/>
        <result property="allowedTools" column="allowed_tools" jdbcType="VARCHAR"/>
        <result property="chatOptions" column="chat_options" jdbcType="VARCHAR"/>
        <result property="apiKey" column="api_key" jdbcType="VARCHAR"/>
        <result property="avatar" column="avatar" jdbcType="VARCHAR"/>
        <result property="createdAt" column="created_at" jdbcType="TIMESTAMP_WITH_TIMEZONE"/>
        <result property="updatedAt" column="updated_at" jdbcType="TIMESTAMP_WITH_TIMEZONE"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,name,description,
        system_prompt,model,allowed_tools,
        chat_options,created_at,
        updated_at,api_key,avatar
    </sql>

    <insert id="insert" parameterType="com.mindharness.model.entity.Agent"
            keyColumn="id" keyProperty="id" useGeneratedKeys="true">
        INSERT INTO agent
        (name,
         description,
         system_prompt,
         model,
         allowed_tools,
         chat_options,
         created_at,
         updated_at,
         api_key,
         avatar)
        VALUES (#{name},
                #{description},
                #{systemPrompt},
                #{model},
                CAST(#{allowedTools} AS jsonb),
                CAST(#{chatOptions} AS jsonb),
                #{createdAt},
                #{updatedAt},
                #{apiKey},
                #{avatar})
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT id,
               name,
               description,
               system_prompt,
               model,
               allowed_tools::text AS allowed_tools,
               chat_options::text  AS chat_options,
               api_key,
               avatar,
               created_at,
               updated_at
        FROM agent
        WHERE id = CAST(#{id} AS uuid)
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT id,
               name,
               description,
               system_prompt,
               model,
               allowed_tools::text AS allowed_tools,
               chat_options::text  AS chat_options,
               api_key,
               avatar,
               created_at,
               updated_at
        FROM agent
        ORDER BY created_at DESC
    </select>

    <delete id="deleteById">
        DELETE
        FROM agent
        WHERE id = CAST(#{id} AS uuid)
    </delete>

    <update id="updateById" parameterType="com.mindharness.model.entity.Agent">
        UPDATE agent
        <set>
            <if test="name != null">
                name = #{name},
            </if>
            <if test="description != null">
                description = #{description},
            </if>
            <if test="systemPrompt != null">
                system_prompt = #{systemPrompt},
            </if>
            <if test="model != null">
                model = #{model},
            </if>

            <if test="allowedTools != null">
                allowed_tools = CAST(#{allowedTools} AS jsonb),
            </if>

            <if test="chatOptions != null">
                chat_options = CAST(#{chatOptions} AS jsonb),
            </if>
            <if test="apiKey != null">
                api_key = #{apiKey},
            </if>
            <if test="avatar != null">
                avatar = #{avatar},
            </if>
            updated_at = NOW()
        </set>

        WHERE id = CAST(#{id} AS uuid)
    </update>
</mapper>
